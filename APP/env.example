# Environmental Configuration Template for ICTM Framework
# Rename to .env and place inside the APP directory

# Application Settings
APP_KEY="your-license-key-here"
SITE_NAME="Your Site Name"
APP_VERSION="1.0.0"

# Database Configuration
# Supported connections: mysql, sqlite
DB_CONNECTION="sqlite"
DB_FILE="APP/Config/database.ic"

# MySQL Credentials (uncomment to use MySQL)
# DB_HOST="localhost"
# DB_USER="root"
# DB_PASS=""
# DB_NAME="your_database_name"

# Mailer Settings
MAIL_HOST="mail.domain.com"
MAIL_FROM_ADDRESS="user@domain.com"
MAIL_FROM_NAME="User"
MAIL_PORT="465"
MAIL_PASSWORD="password"
